#!/usr/bin/env bash
set -u
mix escript.build >/dev/null
code=$?
if [ "$code" -ne 0 ]; then exit "$code"; fi
output=$(escript ./nix_ex --help 2>&1)
code=$?
if [ "$code" -ne 0 ] || [[ "$output" != *"demo DESTINATION"* ]]; then
  printf 'CLI help failed: %s\n' "$output" >&2
  exit 1
fi
output=$(escript ./nix_ex unsupported 2>&1)
code=$?
if [ "$code" -eq 0 ] || [[ "$output" != *"usage:"* ]]; then
  printf 'CLI invalid command failed: %s\n' "$output" >&2
  exit 1
fi
repository=$(pwd)
examples_cli_tmp=$(mktemp -d "${TMPDIR:-/tmp}/nix-ex-cli-examples.XXXXXX")
if [ "$?" -ne 0 ]; then exit 1; fi
# Only this test's freshly allocated directory is removed on exit.
trap 'rm -rf -- "$examples_cli_tmp"' EXIT
cp -R "$repository/examples" "$examples_cli_tmp/generator sources"
if [ "$?" -ne 0 ]; then exit 1; fi
failures=0
for command in demo check-demo; do
  output=$(cd "$examples_cli_tmp" && escript "$repository/nix_ex" "$command" "$examples_cli_tmp/built-in demo" 2>&1)
  code=$?
  if [ "$code" -ne 0 ] || [[ "$output" != *"Generated "* ]]; then
    printf 'CLI %s failed: %s\n' "$command" "$output" >&2
    failures=$((failures + 1))
  fi
done
if [ -f "$examples_cli_tmp/built-in demo/default.nix" ]; then
  printf '\n# deliberate test drift\n' >> "$examples_cli_tmp/built-in demo/default.nix"
  output=$(escript "$repository/nix_ex" check-demo "$examples_cli_tmp/built-in demo" 2>&1)
  code=$?
  if [ "$code" -eq 0 ] || [[ "$output" != *"differs"* ]]; then
    printf 'CLI check-demo failed to detect drift: %s\n' "$output" >&2
    failures=$((failures + 1))
  fi
fi
for example in 01_macro_and_recursion 02_imports_and_assets 03_module_merging 04_overlay 05_stream 06_intentional_error; do
  output=$(cd "$examples_cli_tmp" && escript "$repository/nix_ex" generate "$examples_cli_tmp/generator sources/$example.exs" "$examples_cli_tmp/generated $example" 2>&1)
  code=$?
  if [ "$code" -ne 0 ] || [[ "$output" != *"Generated "* ]]; then
    printf 'CLI example %s failed: %s\n' "$example" "$output" >&2
    failures=$((failures + 1))
  fi
done
# The everyday workflow runs without paths or attributes in the command line.
printf '%s\n' 'import NixEx.DSL' 'nix do: %{answer: 42}' > "$examples_cli_tmp/generate.exs"
for command in convert check; do
  output=$(cd "$examples_cli_tmp" && escript "$repository/nix_ex" "$command" 2>&1)
  code=$?
  if [ "$code" -ne 0 ]; then
    printf 'CLI %s defaults failed: %s\n' "$command" "$output" >&2
    failures=$((failures + 1))
  fi
done
printf '%s\n' 'throw "deliberate check failure"' > "$examples_cli_tmp/generated/default.nix"
output=$(cd "$examples_cli_tmp" && escript "$repository/nix_ex" check 2>&1)
code=$?
if [ "$code" -eq 0 ] || [[ "$output" != *"deliberate check failure"* ]]; then
  printf 'CLI check did not force a failure: %s\n' "$output" >&2
  failures=$((failures + 1))
fi
printf '%s\n' '{ answer = 42; }' > "$examples_cli_tmp/import with spaces.nix"
output=$(escript "$repository/nix_ex" import "$examples_cli_tmp/import with spaces.nix" 2>&1)
code=$?
if [ "$code" -ne 0 ] || [ ! -f "$examples_cli_tmp/import with spaces.nix.exs" ]; then
  printf 'CLI import failed: %s\n' "$output" >&2
  failures=$((failures + 1))
fi
if [ "$failures" -ne 0 ]; then exit "$failures"; fi
printf 'CLI smoke, drift checks, six examples and short commands passed\n'
