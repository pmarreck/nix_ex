#!/usr/bin/env bash
set -u
mix escript.build >/dev/null
code=$?
if [ "$code" -ne 0 ]; then exit "$code"; fi
output=$(escript ./nix_ex --help 2>&1)
code=$?
if [ "$code" -ne 0 ] || [[ "$output" != *"demo DESTINATION"* ]]; then
  printf 'CLI help failed: %s\n' "$output" >&2
  exit 1
fi
output=$(escript ./nix_ex unsupported 2>&1)
code=$?
if [ "$code" -eq 0 ] || [[ "$output" != *"usage:"* ]]; then
  printf 'CLI invalid command failed: %s\n' "$output" >&2
  exit 1
fi
repository=$(pwd)
examples_cli_tmp=$(mktemp -d "${TMPDIR:-/tmp}/nix-ex-cli-examples.XXXXXX")
if [ "$?" -ne 0 ]; then exit 1; fi
# Only this test's freshly allocated directory is removed on exit.
trap 'rm -rf -- "$examples_cli_tmp"' EXIT
cp -R "$repository/examples" "$examples_cli_tmp/generator sources"
if [ "$?" -ne 0 ]; then exit 1; fi
failures=0
for example in 01_macro_and_recursion 02_imports_and_assets 03_module_merging 04_overlay 05_stream 06_intentional_error; do
  output=$(cd "$examples_cli_tmp" && escript "$repository/nix_ex" generate "$examples_cli_tmp/generator sources/$example.exs" "$examples_cli_tmp/generated $example" 2>&1)
  code=$?
  if [ "$code" -ne 0 ] || [[ "$output" != *"Generated "* ]]; then
    printf 'CLI example %s failed: %s\n' "$example" "$output" >&2
    failures=$((failures + 1))
  fi
done
if [ "$failures" -ne 0 ]; then exit "$failures"; fi
printf 'CLI smoke and six examples from another cwd passed\n'
